{
  "name": "bug-management-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^5.2.0",
    "antd": "^5.11.0",
    "axios": "^1.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "typescript": "^4.9.5"
  },
  "scripts": {
  "start": "react-scripts start",
  "build": "react-scripts build",
  "test": "react-scripts test",
  
  "test:e2e": "playwright test",
  "test:e2e:ui": "playwright test --ui",
  
  "test:smoke": "playwright test tests/smoke/smoke.spec.js",
  "test:smoke:ui": "playwright test tests/smoke/smoke.spec.js --ui",
  "test:smoke:debug": "playwright test tests/smoke/smoke.spec.js --debug",
  "test:smoke:headed": "playwright test tests/smoke --headed",
  "test:report": "playwright show-report",
  
  "eject": "react-scripts eject"
},
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
